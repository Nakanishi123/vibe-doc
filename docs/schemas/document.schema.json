{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vdoc.local/schemas/document.schema.json",
  "title": "VDoc Document Frontmatter",
  "type": "object",
  "required": ["id", "title", "kind"],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": ["spec", "design", "adr", "task", "task-index"]
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
